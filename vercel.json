{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "juancruzconsciencia.lat"
        }
      ],
      "source": "/",
      "destination": "/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "www.juancruzconsciencia.lat"
        }
      ],
      "source": "/",
      "destination": "/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "registro.juancruzconsciencia.lat"
        }
      ],
      "source": "/(.*)",
      "destination": "/registro_jcc.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/backup-diario",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/ig-sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/tiktok",
      "schedule": "10 9 * * *"
    },
    {
      "path": "/api/gsc-sync",
      "schedule": "0 9 * * 1"
    }
  ],
  "functions": {
    "api/ig-sync.js": {
      "maxDuration": 60
    },
    "api/tiktok.js": {
      "maxDuration": 60
    },
    "api/gsc-sync.js": {
      "maxDuration": 30
    }
  }
}
